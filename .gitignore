# ============================================================================
# 浅上小站 —— 仓库根忽略规则
#
# 仓库是三模块结构：
#   ai/       Python  AI 服务（FastAPI + LangGraph）
#   backend/  Java    业务后端（Spring Boot + Maven）
#   frontend/ Vue 3   前端
#
# 各模块目录内另有自己的 .gitignore，本文件负责跨模块的通用规则与兜底。
# ============================================================================

# ---------------------------------------------------------------------------
# 密钥与环境变量
# 真实密钥只存在于本地 .env，绝不入库；只提交示例文件
# ---------------------------------------------------------------------------
.env
.env.*
!**/.env.example

# 前端 env 仅含 VITE_ 开头的公开配置（本地地址 / 占位域名），可以提交
!/frontend/frontended/.env
!/frontend/frontended/.env.development
!/frontend/frontended/.env.production

*.pem
*.key
*.p12
*.jks
secrets.json

# ---------------------------------------------------------------------------
# Python（ai/）
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
# MCP 服务端专用 venv（bilibili-cognitive-server 装在这里，不污染主环境）
.venv-mcp/
venv/
ENV/
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
coverage.xml
htmlcov/
# pytest 的临时缓存目录（本机文件系统会残留成不可删目录，见 ai/.gitignore 注释）
pytest-cache-files-*/
.piptmp/

# ---------------------------------------------------------------------------
# Node / 前端（frontend/）
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.npm-cache/
.vite/
*.tsbuildinfo
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Java / Maven（backend/）
# ---------------------------------------------------------------------------
target/
*.class
*.jar
!**/.mvn/wrapper/maven-wrapper.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# ---------------------------------------------------------------------------
# 模型权重（体积过大，不入库）
# bge-reranker-v2-m3 约 2.2 GB，远超 GitHub 单文件 100 MB 上限；
# 当前实现改用百炼 gte-rerank API，本地权重目录可删除
# ---------------------------------------------------------------------------
reranker_models/
models/
*.safetensors
*.onnx
*.gguf
*.pt
*.pth

# ---------------------------------------------------------------------------
# 运行时数据（本地生成，不应进版本库）
# ---------------------------------------------------------------------------
chroma_db/
knowledge/
.chroma_selftest/
uploads/
logs/
*.log
*.sqlite
*.sqlite3
*.db
*.dump

# ---------------------------------------------------------------------------
# 本地素材备份（未在代码中引用的截图、原始大图，仅留存在本机）
# ---------------------------------------------------------------------------
_unused_assets/

# ---------------------------------------------------------------------------
# IDE / 操作系统
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# 临时 / 调试产物
# ---------------------------------------------------------------------------
*.tmp
*.bak
*.orig
*.rej
