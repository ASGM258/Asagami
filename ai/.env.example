# ==================== 服务配置 ====================
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
DEBUG=True
CORS_ORIGINS=*

# ==================== DeepSeek / LLM ====================
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_API_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000

# ==================== PostgreSQL（AI 问答的会话与消息） ====================
# 格式：postgresql://用户名:密码@主机:端口/数据库名
# 注意：库必须你先手工建好（程序只自动建表，不建库）
AI_DATABASE_URL=postgresql://postgres:123456@localhost:5432/anime_ai
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10

# ==================== MySQL（动漫业务数据 + 资讯） ====================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=backend_asagami

# ==================== 其他 ====================
SKIP_DB_INIT=False

# ==================== 资讯抓取（news） ====================
ANINEWS_BASE_URL=https://aninews.vercel.app
ANINEWS_ENDPOINT=/api/news
ANINEWS_ENABLED=True
# 备用 RSS：支持逗号分隔的多个地址；Anime News Network / Crunchyroll 会返回 403
NEWS_FALLBACK_RSS=https://myanimelist.net/rss/news.xml,https://animecorner.me/feed/
NEWS_FETCH_TIMEOUT=20
NEWS_FETCH_LIMIT=20
NEWS_FETCH_OVER_FETCH=3
# 正文补全：RSS 只给摘要（MAL 约 500 字、Anime Corner 约 100 字，且都在词中间截断），
# 因此需要回到详情页抓全文。
NEWS_ENRICH_ENABLED=True
# 单轮最多补全多少条（每条一次 HTTP 请求）
NEWS_ENRICH_LIMIT=20
NEWS_ENRICH_TIMEOUT=15
# 请求间隔（秒），避免被站点限流
NEWS_ENRICH_DELAY=0.3
# 正文短于该字符数即视为残缺，需要补全
NEWS_ENRICH_MIN_CHARS=600
NEWS_SCHEDULER_ENABLED=False
NEWS_SCHEDULER_CRON=0 6 * * *

LLM_TRANSLATE_TEMPERATURE=0.3
LLM_SUMMARY_TEMPERATURE=0.5
LLM_REVIEW_TEMPERATURE=0.0
# 翻译节点要输出整篇正文，1000 tokens 会把长文译文截断，故单独给更大的上限
NEWS_LLM_MAX_TOKENS=4000
# 翻译节点送入模型的正文上限（字符），超出按句子边界截断
NEWS_TRANSLATE_INPUT_LIMIT=12000

# ==================== MCP：B站认知服务 ====================
# 服务端装在独立 venv（ai/.venv-mcp），不污染主环境：
#   python -m venv .venv-mcp
#   .venv-mcp\Scripts\pip install bilibili-cognitive-server
# 或直接运行 ai/setup_bilibili_mcp.bat
BILIBILI_MCP_ENABLED=True
# 留空则自动探测 ai/.venv-mcp/Scripts/bili-mcp.exe 或 PATH 中的 bili-mcp
BILIBILI_MCP_COMMAND=
BILIBILI_MCP_TIMEOUT=30
# 为排序补取多少个视频的点赞/收藏等详情（每个一次 MCP 调用）
BILIBILI_DETAIL_LIMIT=10
# Cookie：视频搜索匿名可用；「我的信息」「字幕」等工具需要登录态
BILI_SESSDATA=
BILI_BILI_JCT=
BILI_BUVID3=

# ==================== RAG 知识库 ====================
# Embedding 提供方：dashscope（阿里云百炼，推荐）| local（本地兜底，仅自测）
#
# ⚠️ DeepSeek 没有 embedding 接口，RAG 必须单独配置 embedding 来源。
#    provider=dashscope 但未填 key 时会自动回退 local，检索质量明显下降，
#    生产环境请务必配置 key。
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v3
# 阿里云百炼 API Key（https://bailian.console.aliyun.com/ 申请）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 向量库与原始文件目录（默认落在 ai/ 下）
CHROMA_PERSIST_DIR=chroma_db
KNOWLEDGE_DIR=knowledge
# 分块参数（字符数）与单文件大小上限（MB）
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_MAX_FILE_SIZE_MB=10

# ---------- 混合检索：向量 + BM25（关键词） ----------
# 向量检索对专有名词（角色名/作品名）天生弱，BM25 补词面精确命中。
# 中文必须分词（内置 jieba + 汉字二元组，词典外的专名靠二元组兜住）。
RAG_BM25_ENABLED=True
# 两路融合权重（RRF 只看名次，不需要对齐分数尺度）
RAG_VECTOR_WEIGHT=1.0
RAG_BM25_WEIGHT=1.0
RAG_RRF_K=60
# 每路候选数、融合后送去重排的条数
RAG_CANDIDATE_POOL=20
# 实测 gte-rerank-v2 超过 8 条会内部拆批，耗时从 ~320ms 跳到 ~1.2s
RAG_PRE_RERANK_K=8

# ---------- 重排：百炼 text-rerank（复用上面的 DASHSCOPE_API_KEY） ----------
# 关掉后仍享有 BM25 混合检索，且检索零额外延迟
RAG_RERANK_ENABLED=True
# 注意：gte-rerank 在新账号上会 403，必须用 v2
RAG_RERANK_MODEL=gte-rerank-v2
RAG_RERANK_TIMEOUT=15
