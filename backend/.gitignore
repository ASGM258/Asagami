# ============================================================================
# backend/ —— Spring Boot + Maven
# 根目录 .gitignore 已覆盖通用规则，这里补充本模块特有的
# ============================================================================

# 环境变量（含数据库密码等，绝不入库）
.env
.env.*
!.env.example

# Maven 构建产物
target/
*.jar
!**/.mvn/wrapper/maven-wrapper.jar
*.war
*.class
dependency-reduced-pom.xml
.mvn/timing.properties

# 运行日志与 JVM 崩溃日志
logs/
*.log
hs_err_pid*
replay_pid*

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp

# 本地数据库 / 备份
*.sqlite
*.db
*.dump
